# Testnet-realistic local profile — match the public Aztec testnet's timing and
# keep proving on, so behaviour mirrors what you'll see after deploying to
# testnet (Stage 6.5). Slower than .env.fast; use it to validate timing-sensitive
# flows (governance windows, fee/proof behaviour) before shipping.
#
# Usage:
#   docker compose --env-file .env.testnet-like --profile aztec up --build
#
# These values equal the docker-compose.yml defaults, so plain
# `docker compose --profile aztec up` is equivalent to this profile.
#  - PXE_PROVER_ENABLED=true  : generate real ClientIVC proofs (as on testnet).
#  - AZTEC_SLOT_DURATION=36   : the documented safe-fast slot; 3 L1 blocks/slot.
#  - SEQ_L1_PUBLISHING_TIME_ALLOWANCE_IN_SLOT=24 : 2 L1 blocks of publishing
#    headroom, leaving 12s for build + attestation (prune-free).

PXE_PROVER_ENABLED=true
AZTEC_SLOT_DURATION=36
ETHEREUM_SLOT_DURATION=12
ANVIL_BLOCK_TIME=12
SEQ_L1_PUBLISHING_TIME_ALLOWANCE_IN_SLOT=24
GOVERNANCE_VOTING_WINDOW_BLOCKS=5
WALLET_MIN_FEE_PADDING=30
