# Fair Squares -- Environment Variables
#
# For simulation mode (no Aztec needed):
#   cp .env.local.example .env.local
#
# For live Aztec mode (set automatically by docker compose --profile aztec up):
#   The bootstrap container writes .env.local with real contract addresses.

# -- Mode ---------------------------------------------------------------------
# Simulation mode: uses in-memory state (no Aztec sandbox needed)
NEXT_PUBLIC_SIMULATION=true

# Dev mode: enables "Skip KYC" button
NEXT_PUBLIC_DEV_MODE=true

# -- Aztec (set automatically by bootstrap, or manually for local dev) --------
# AZTEC_LIVE=true
# NEXT_PUBLIC_AZTEC_PXE_URL=http://localhost:8080

# -- Contract Addresses (set by bootstrap-local-network.sh) -------------------
# NEXT_PUBLIC_HOUSING_FUND_ADDRESS=
# NEXT_PUBLIC_FUND_TOKEN_ADDRESS=
# NEXT_PUBLIC_KYC_VERIFIER_ADDRESS=
# NEXT_PUBLIC_GOVERNANCE_ADDRESS=
# NEXT_PUBLIC_DEFI_VAULT_ADDRESS=
# NEXT_PUBLIC_ADMIN_ADDRESS=

# -- zkPassport ---------------------------------------------------------------
# ZKPASSPORT_DOMAIN=fair-squares.local
# ZKPASSPORT_VERIFIER_PRIVATE_KEY=
