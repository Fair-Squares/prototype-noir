# Vercel environment variables (set these in the Vercel dashboard)
# These enable simulation mode — no Aztec node needed.

AZTEC_LIVE=false
NEXT_PUBLIC_SIMULATION=true
NEXT_PUBLIC_DEV_MODE=false

# Simulation-only governance window (minutes). Default is 5.
GOVERNANCE_VOTING_WINDOW_MINUTES=5
# DEX price guardrail around estimated share price reference (basis points)
DEX_PRICE_BAND_BPS=200
DEX_MAX_TTL_BLOCKS=120
# Rewards distribution defaults
PROTOCOL_REWARDS_START=2026-01-01T00:00:00.000Z
PROTOCOL_REWARDS_CLAIM_MIN=1
# Optional recursive-proof rollout flags
# REQUIRE_RECURSIVE_PROOFS=true
# Recursive verifier VK hash values (Field)
# FUND_TOKEN_PRIVATE_HOLDER_VK_HASH=0
# HOUSING_FUND_VALUATION_VK_HASH=0
# PROTOCOL_REWARDS_WEIGHTS_VK_HASH=0
# Live/local quorum default:
# GOVERNANCE_MIN_QUORUM_VOTES=2
# Live/local contracts use block windows via bootstrap:
# GOVERNANCE_VOTING_WINDOW_BLOCKS=300

# Leave contract addresses empty for Vercel (simulation uses in-memory state)
# Or fill with a deployed testnet address when available:
# NEXT_PUBLIC_KYC_VERIFIER_ADDRESS=
# NEXT_PUBLIC_FUND_TOKEN_ADDRESS=
# NEXT_PUBLIC_DEFI_VAULT_ADDRESS=
# NEXT_PUBLIC_HOUSING_FUND_ADDRESS=
# NEXT_PUBLIC_GOVERNANCE_ADDRESS=
# NEXT_PUBLIC_FSFT_DEX_ADDRESS=
# NEXT_PUBLIC_EUR_TOKEN_ADDRESS=
# NEXT_PUBLIC_PROTOCOL_TOKEN_ADDRESS=
# NEXT_PUBLIC_PROTOCOL_REWARDS_ADDRESS=

# ────────────────────────────────────────────────────────────────────────────
# Local Docker dev: use docker compose --profile aztec up
# Bootstrap writes .env.local automatically with AZTEC_LIVE=true
# ────────────────────────────────────────────────────────────────────────────
