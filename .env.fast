# Fast local-dev profile — optimize for iteration speed, not testnet realism.
#
# Usage:
#   docker compose --env-file .env.fast --profile aztec up --build
#
# Levers (all verified to let the node start; load-tested via a full bootstrap):
#  - Proverless: a real ClientIVC proof costs ~4s/tx and is not required on a
#    local network. Two flags are needed because different clients read
#    different vars:
#      * PXE_PROVER_ENABLED=false  → aztec node + frontend EmbeddedWallet
#      * PXE_PROVER=none           → bootstrap cli-wallet (aztec-wallet)
#  - Faster L1 + shorter L2 slot: with ANVIL_BLOCK_TIME=6 the L1 checkpoint
#    publishes quickly, so a smaller publishing allowance (8s) fits and the L2
#    slot can drop to 24s (4 L1 blocks) — vs the 36s testnet-like value. The
#    node refuses to start if the slot can't fit (publishing allowance + ~10s
#    build/attestation), so these three move together.
#    aztecSlotDuration must remain a multiple of ethereumSlotDuration.
#
# If the aztec logs show "Pruning blocks" or "SequencerTooSlowError" under load,
# fall back to the conservative timing in the commented block below.

PXE_PROVER_ENABLED=false
PXE_PROVER=none
AZTEC_SLOT_DURATION=24
ETHEREUM_SLOT_DURATION=6
ANVIL_BLOCK_TIME=6
SEQ_L1_PUBLISHING_TIME_ALLOWANCE_IN_SLOT=8
GOVERNANCE_VOTING_WINDOW_BLOCKS=5
WALLET_MIN_FEE_PADDING=30

# ---- Conservative fallback (proverless only, testnet-like timing) ------------
# If the aggressive timing above is unstable, comment it out and use these
# (slot 36 @ L1 12s is the proven prune-free timing; still proverless):
# AZTEC_SLOT_DURATION=36
# ETHEREUM_SLOT_DURATION=12
# ANVIL_BLOCK_TIME=12
# SEQ_L1_PUBLISHING_TIME_ALLOWANCE_IN_SLOT=24
